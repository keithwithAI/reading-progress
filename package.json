{
	"name": "note-reading-progress",
	"author": "keithwithai",
	"version": "0.2.0",
	"description": "Shows remaining reading time and scroll progress for the current note in both edit and reading modes.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src/",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run"
	},
	"keywords": [
		"obsidian-md",
		"reading-time",
		"reading-progress"
	],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/node": "^20.19.43",
		"esbuild": "0.20.0",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"obsidian": "latest",
		"tslib": "^2.6.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.4",
		"vitest": "^3.2.7"
	}
}
